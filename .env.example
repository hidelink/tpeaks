# Base de datos (Supabase Postgres). Son DOS urls y la diferencia importa:
#
# DATABASE_URL — la que usa la app en runtime. Pooler en TRANSACTION MODE,
#   puerto 6543. En session mode (5432) cada conexión acapara un backend de
#   Postgres y el tope son 15 clientes: con varias instancias serverless en
#   paralelo se agota y la app entera devuelve 500. Ya pasó en producción.
# DIRECT_URL — solo para `prisma migrate`. Conexión directa, puerto 5432: las
#   migraciones necesitan advisory locks que el pooler en transaction mode no
#   soporta.
DATABASE_URL="postgresql://user:password@host:6543/postgres"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Clerk (auth + Organizations = Team). https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."

# Clerk: habilitar Organizations en el dashboard y forzar que todo usuario
# tenga una organización activa (un coach crea una al registrarse).
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Stripe (Fase 2 — no se usa todavía, dejar en blanco es válido en Fase 1).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
