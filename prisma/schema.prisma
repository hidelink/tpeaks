// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Ver docs/PRODUCT_SPEC.md (Paso 4) para el razonamiento detrás de cada tabla.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Rol dentro de un club. Es JERÁRQUICO y de un solo valor: ADMIN puede todo
/// lo que puede un COACH. No se modela "es admin Y socio" — quien quiera ser
/// socio de su propio club usa otra cuenta. Ver src/lib/roles.ts.
///
/// Los permisos NO se checan comparando el rol directamente, sino contra las
/// capacidades de src/lib/roles.ts: si mañana entra ASSISTANT_COACH, se agrega
/// ahí y no hay que auditar cada Server Action de nuevo.
enum MembershipRole {
  /// Todos los permisos del club, incluidos los cobros cuando existan. En un
  /// club de una persona, este es el único rol que hace falta.
  /// OJO: no confundir con el admin de PLATAFORMA (User.isPlatformAdmin), que
  /// es soporte interno y vive en otra tabla.
  ADMIN
  COACH
  /// Socio del club.
  ATHLETE
}

enum MembershipStatus {
  INVITED
  ACTIVE
  REMOVED
}

enum WorkoutStatus {
  PLANNED
  COMPLETED
  MISSED
  SKIPPED
}

// Tipo de sesión. La estructura (segmentos con duración/RPE/nota) ya servía
// para cualquier deporte; esto solo decide qué campos tienen sentido enseñar
// y qué cuenta como kilometraje de carrera. Ver src/lib/sports.ts.
enum WorkoutSport {
  RUN
  TRAIL_RUN
  BIKE
  SWIM
  STRENGTH
  MOBILITY
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  /// Avisó que no venía. Un club chico lo distingue de faltar sin avisar.
  EXCUSED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  PAUSED
}

enum IntegrationProvider {
  GARMIN
  COROS
  POLAR
  SUUNTO
  APPLE_HEALTH
  STRAVA
}

model Team {
  id           String  @id @default(cuid())
  // Vincula este Team con su Clerk Organization — Clerk maneja identidad e
  // invitaciones; nuestra tabla decide roles finos y permisos (ver Paso 3).
  clerkOrgId   String  @unique
  name         String
  slug         String  @unique
  logoUrl      String?
  primaryColor String?
  /// Zona horaria IANA del club. "Hoy" se calcula aquí y no en el servidor:
  /// Vercel corre en UTC, así que sin esto un club en México ve los números de
  /// mañana a partir de las 18:00. Ver src/lib/club-time.ts.
  timezone     String  @default("America/Mexico_City")

  // Fase 2 — el gate de suscripción no se activa hasta entonces,
  // pero el campo existe desde hoy para no requerir una migración después.
  subscriptionStatus SubscriptionStatus @default(TRIALING)
  stripeCustomerId   String?            @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  TeamMembership[]
  templates    WorkoutTemplate[]
  scheduled    ScheduledWorkout[]
  groups       TrainingGroup[]
  sessions     ClubSession[]
  subscription Subscription?
}

model User {
  id              String   @id @default(cuid())
  clerkUserId     String   @unique
  email           String   @unique
  name            String
  avatarUrl       String?
  // Admin de la plataforma (soporte interno) — NO es un rol de equipo, por
  // eso vive en User y no en TeamMembership.role: un admin puede necesitar
  // ver equipos a los que no pertenece. Se activa a mano (scripts/make-admin.ts),
  // no hay UI de auto-gestión — son muy pocas personas las que lo necesitan.
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())

  memberships TeamMembership[]
}

model TeamMembership {
  id        String           @id @default(cuid())
  teamId    String
  userId    String
  role      MembershipRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])

  athleteProfile     AthleteProfile?
  groups             TrainingGroupMember[]
  attendance         SessionAttendance[]
  sessionsAsCoach    ClubSession[]         @relation("SessionCoach")
  scheduledAsAthlete ScheduledWorkout[]    @relation("AthleteSchedules")
  scheduledAsCoach   ScheduledWorkout[]    @relation("CoachSchedules")
  coachComments      CoachComment[]
  integrations       Integration[]

  @@unique([teamId, userId])
}

model AthleteProfile {
  id               String    @id @default(cuid())
  membershipId     String    @unique
  dateOfBirth      DateTime?
  sex              String?
  // Notas privadas del coach: nunca se exponen al atleta en ninguna pantalla/API.
  coachPrivateNote String?

  // Ritmos de entrenamiento (ver src/lib/vdot.ts) — calculados a partir de un
  // resultado de carrera reciente. Solo tiene sentido en carreras planas
  // (pista/asfalto); no aplica a trail (desnivel/terreno rompen el modelo).
  raceResultDistanceMeters Float?
  raceResultTimeSeconds    Int?
  vdot                     Float?

  createdAt DateTime @default(now())

  membership TeamMembership @relation(fields: [membershipId], references: [id])
}

/// Grupo de entrenamiento dentro de un club: "avanzados", "principiantes",
/// "grupo de trail". Un club chico puede no usarlos; uno de 40 socios los
/// necesita para no asignar de uno en uno.
model TrainingGroup {
  id          String   @id @default(cuid())
  teamId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team     Team                  @relation(fields: [teamId], references: [id])
  members  TrainingGroupMember[]
  sessions ClubSession[]

  /// Dos grupos con el mismo nombre en el mismo club serían indistinguibles
  /// en el selector de asignación.
  @@unique([teamId, name])
}

/// Un socio puede estar en varios grupos a la vez (ej. "avanzados" y "trail"),
/// por eso es tabla de unión y no un campo en TeamMembership.
model TrainingGroupMember {
  id           String   @id @default(cuid())
  groupId      String
  membershipId String
  createdAt    DateTime @default(now())

  group      TrainingGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  membership TeamMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([groupId, membershipId])
  @@index([membershipId])
}

/// Entrenamiento presencial del club: día, hora, lugar y quién lo da. Es la
/// vida diaria de un club y lo que justifica la mensualidad — distinto de
/// ScheduledWorkout, que es el plan individual de un socio y puede hacerse solo.
model ClubSession {
  id                String   @id @default(cuid())
  teamId            String
  /// Null = abierta a todo el club.
  groupId           String?
  coachMembershipId String?
  title             String
  /// Solo fecha, igual que ScheduledWorkout: ver el porqué en calendar-date.ts.
  date              DateTime @db.Date
  /// Hora local del club como "HH:mm". A propósito NO es un timestamp: "los
  /// martes a las 7:00 en el parque" es un hecho en la hora local del club, y
  /// convertirlo a UTC solo reintroduce la clase de bug que ya costó dos
  /// arreglos en este proyecto.
  startTime         String
  location          String?
  note              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  team       Team                @relation(fields: [teamId], references: [id])
  group      TrainingGroup?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  coach      TeamMembership?     @relation("SessionCoach", fields: [coachMembershipId], references: [id], onDelete: SetNull)
  attendance SessionAttendance[]

  @@index([teamId, date])
}

/// Pase de lista. Solo existe fila para quien ya fue marcado: la ausencia de
/// fila significa "todavía no se pasó lista", que no es lo mismo que faltar.
model SessionAttendance {
  id           String           @id @default(cuid())
  sessionId    String
  membershipId String
  status       AttendanceStatus
  note         String?
  markedAt     DateTime         @default(now())

  session    ClubSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  membership TeamMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([sessionId, membershipId])
  @@index([membershipId])
}

model WorkoutTemplate {
  id          String       @id @default(cuid())
  teamId      String
  createdById String
  title       String
  description String?
  sport       WorkoutSport @default(RUN)
  // Ver el contrato Zod en src/lib/workout-structure.ts — no es un blob libre.
  structure   Json
  tags        String[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  team      Team               @relation(fields: [teamId], references: [id])
  scheduled ScheduledWorkout[]
}

model ScheduledWorkout {
  id                  String        @id @default(cuid())
  teamId              String
  athleteMembershipId String
  coachMembershipId   String
  templateId          String?
  // Solo fecha, sin hora: evita bugs de "apareció en el día equivocado"
  // cuando coach y atleta están en zonas horarias distintas.
  date                DateTime      @db.Date
  title               String
  // Snapshot igual que structure: cambiar el deporte de la plantilla no debe
  // reescribir lo ya asignado.
  sport               WorkoutSport  @default(RUN)
  // Snapshot copiado de WorkoutTemplate.structure al momento de asignar.
  // Editar la plantilla después NO debe alterar esto retroactivamente.
  structure           Json
  coachNote           String?
  status              WorkoutStatus @default(PLANNED)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  team     Team             @relation(fields: [teamId], references: [id])
  athlete  TeamMembership   @relation("AthleteSchedules", fields: [athleteMembershipId], references: [id])
  coach    TeamMembership   @relation("CoachSchedules", fields: [coachMembershipId], references: [id])
  template WorkoutTemplate? @relation(fields: [templateId], references: [id])

  completion    WorkoutCompletion?
  comments      CoachComment[]
  activityLinks WorkoutActivityLink[]

  @@index([teamId, athleteMembershipId, date])
}

model WorkoutCompletion {
  id                 String   @id @default(cuid())
  scheduledWorkoutId String   @unique
  completedAt        DateTime @default(now())
  durationMinutes    Int?
  distanceKm         Float?
  perceivedPace      String?
  // RPE (Rate of Perceived Exertion), escala 1-10.
  rpe                Int?
  athleteComment     String?

  scheduledWorkout ScheduledWorkout @relation(fields: [scheduledWorkoutId], references: [id])
}

model CoachComment {
  id                 String   @id @default(cuid())
  scheduledWorkoutId String
  coachMembershipId  String
  comment            String
  createdAt          DateTime @default(now())

  scheduledWorkout ScheduledWorkout @relation(fields: [scheduledWorkoutId], references: [id])
  coach            TeamMembership   @relation(fields: [coachMembershipId], references: [id])
}

// ---- Fase 2: existe desde hoy, inactivo hasta que se conecte Stripe ----
model Subscription {
  id                   String             @id @default(cuid())
  teamId               String             @unique
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(TRIALING)
  seatsIncluded        Int                @default(0)
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  team Team @relation(fields: [teamId], references: [id])
}

// ---- Fase 3: existe desde hoy, sin sync jobs activos ----
model Integration {
  id                String              @id @default(cuid())
  membershipId      String
  provider          IntegrationProvider
  externalAccountId String
  // Cifrado a nivel de aplicación antes de persistir (ver docs/PRODUCT_SPEC.md, riesgos).
  accessToken       String
  refreshToken      String?
  connectedAt       DateTime            @default(now())
  lastSyncedAt      DateTime?

  membership TeamMembership     @relation(fields: [membershipId], references: [id])
  activities ExternalActivity[]

  @@unique([membershipId, provider])
}

model ExternalActivity {
  id              String   @id @default(cuid())
  integrationId   String
  externalId      String
  startedAt       DateTime
  durationSeconds Int?
  distanceMeters  Float?
  avgPaceSecPerKm Int?
  avgHeartRate    Int?
  rawPayload      Json?
  createdAt       DateTime @default(now())

  integration Integration           @relation(fields: [integrationId], references: [id])
  links       WorkoutActivityLink[]

  @@unique([integrationId, externalId])
}

model WorkoutActivityLink {
  id                 String   @id @default(cuid())
  scheduledWorkoutId String
  externalActivityId String
  // "auto" | "manual"
  linkedBy           String
  createdAt          DateTime @default(now())

  scheduledWorkout ScheduledWorkout @relation(fields: [scheduledWorkoutId], references: [id])
  externalActivity ExternalActivity @relation(fields: [externalActivityId], references: [id])

  @@unique([scheduledWorkoutId, externalActivityId])
}
